# Server secrets (S03 · D12). Copy to supabase/.env (gitignored) and load with
#   supabase secrets set --env-file supabase/.env
# NEVER reference any of these from app code; the app only knows env/app.<flavor>.json.

# Age ticket signing key (HS256, ≥ 32 chars). age-check signs, issue-pass verifies.
AGE_TICKET_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Shared secret between pg_net/cron and the job functions (reading-worker · reading-reaper
# · photo-delete-runner). The same value goes into public.server_config (key job_secret).
JOB_SECRET=change-me-too

# RevenueCat → webhook "Authorization" header value configured in the RevenueCat dashboard.
REVENUECAT_WEBHOOK_AUTH=change-me

# check-email app key (sent as x-app-key by the app; pre-login, rate limited).
CHECK_EMAIL_APP_KEY=change-me

# Allowed `aud` values (comma-separated) for provider id_tokens — issue-pass.
APPLE_AUD=co.byite.soongong,co.byite.soongong.dev
GOOGLE_AUD=<ios-client-id>.apps.googleusercontent.com,<android-client-id>.apps.googleusercontent.com,<web-client-id>.apps.googleusercontent.com
KAKAO_AUD=<kakao-rest-api-key>

# Injected automatically by the platform (listed for local `supabase functions serve` only):
# SUPABASE_URL=            SUPABASE_ANON_KEY=            SUPABASE_SERVICE_ROLE_KEY=
